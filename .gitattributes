# Normalize to LF in the repository and on checkout. The bundler, cargo, and the
# Linux CI runners all treat LF as canonical, and without this a Windows clone
# rewrites every file to CRLF — which shows up as a whole-repo diff the first
# time anyone edits from the other platform.
* text=auto eol=lf

# Binary assets: never touched.
*.png binary
*.ico binary
*.icns binary
